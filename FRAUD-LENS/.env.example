FRAUDLENS_SECRET_KEY=replace-with-a-long-random-value
FRAUDLENS_DEBUG=true
FRAUDLENS_ALLOWED_HOSTS=localhost,127.0.0.1
FRAUDLENS_MODE=synthetic
FRAUDLENS_ENABLE_LIVE_DATA=false
FRAUDLENS_MAX_UPLOAD_MB=5
FRAUDLENS_API_THROTTLE_RATE=300/min
FRAUDLENS_DB_ENGINE=django.db.backends.sqlite3
FRAUDLENS_DB_NAME=db.sqlite3
FRAUDLENS_DB_USER=fraudlens
FRAUDLENS_DB_PASSWORD=change-me
FRAUDLENS_DB_HOST=localhost
FRAUDLENS_DB_PORT=5432
FRAUDLENS_DB_SSLMODE=prefer
FRAUDLENS_CELERY_BROKER_URL=redis://localhost:6379/0
FRAUDLENS_CELERY_RESULT_BACKEND=redis://localhost:6379/1
FRAUDLENS_CELERY_TASK_ALWAYS_EAGER=false
FRAUDLENS_BASELINE_WINDOW_DAYS=30
FRAUDLENS_AMOUNT_Z_THRESHOLD=3.0
FRAUDLENS_FREQUENCY_Z_THRESHOLD=2.5
FRAUDLENS_HIGH_RISK_THRESHOLD=75
FRAUDLENS_ENABLE_XGBOOST=true
FRAUDLENS_ENABLE_SHAP=true
FRAUDLENS_LOG_LEVEL=INFO
